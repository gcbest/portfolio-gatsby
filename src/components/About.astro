---
import { Image } from "astro:assets";
import me from "../assets/img/me.jpg";
import Icon from "./Icon.astro";
---

<section id="about" class="about-area section-padding">
  <div class="container">
    <div class="row">
      <div class="col-md-4">
        <div class="about-image wow fadeInUp" data-wow-delay="0.2s">
          <Image
            src={me}
            alt="Godfrey Best"
            widths={[320, 480, 640]}
            sizes="(max-width: 768px) 100vw, 360px"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="social-links text-center wow fadeIn" data-wow-delay="0.4s">
          <ul>
            <li>
              <a href="https://www.linkedin.com/in/godfreybest">
                <Icon name="linkedin" />
              </a>
            </li>
            <li>
              <a href="https://github.com/gcbest">
                <Icon name="github" />
              </a>
            </li>
            <li>
              <a
                href="https://www.youtube.com/@GetInRhythm/search?query=godfrey%20best"
              >
                <Icon name="youtube" />
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="col-md-8">
        <div class="about-text">
          <h2 data-aos="fade-up" data-aos-delay="100" data-aos-duration="500">
            About Me
          </h2>
          <p data-aos="fade-up" data-aos-delay="300" data-aos-duration="500">
            As a life-long learner, I spend much of my free time reading about
            and practicing web development.
          </p>
          <p data-aos="fade-up" data-aos-delay="500" data-aos-duration="1000">
            I am passionate about building tools which enable people to better
            themselves.
          </p>
          <p data-aos="fade-up" data-aos-delay="700" data-aos-duration="1000">
            I'm also deeply fascinated by how technology enables us to store and
            transmit vast amounts of information in fractions of a second.
          </p>
          <p data-aos="fade-up" data-aos-delay="1000" data-aos-duration="1000">
            I enjoy most activities which are creative, competitive, and
            repetitive. The feeling of iteratively improving at a certain task is
            something that motivates me in any challenge I undertake.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
