---
import Icon from "./Icon.astro";
---

<form
  id="contactForm"
  class="contact-form shake"
  data-toggle="validator"
  data-netlify="true"
  name="contact"
  action="/"
  method="POST"
>
  <input type="hidden" name="form-name" value="contact" aria-label="contact" />

  <div class="row">
    <div class="col-md-6">
      <div class="form-group wow fadeInUp" data-wow-delay="0.2s">
        <div class="controls">
          <input
            type="text"
            id="name"
            class="form-control"
            placeholder="Name"
            required
            name="name"
            aria-label="name"
            data-error="Please enter your name"
          />
          <div class="help-block with-errors"></div>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-group wow fadeInUp" data-wow-delay="0.2s">
        <div class="controls">
          <input
            type="email"
            class="email form-control"
            id="email"
            placeholder="Email"
            required
            name="email"
            aria-label="email"
            data-error="Please enter your email"
          />
          <div class="help-block with-errors"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <div class="form-group wow fadeInUp" data-wow-delay="0.4s">
        <div class="controls">
          <input
            type="text"
            id="msg_subject"
            class="form-control"
            placeholder="Subject"
            required
            name="subject"
            aria-label="subject"
            data-error="Please enter your message subject"
          />
          <div class="help-block with-errors"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <div class="form-group wow fadeInUp" data-wow-delay="0.6s">
        <div class="controls">
          <textarea
            id="message"
            name="message"
            rows="7"
            placeholder="Message"
            class="form-control"
            required
            aria-label="message"
            data-error="Write your message"
          ></textarea>
          <div class="help-block with-errors"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <div id="formStatus" class="form-status" role="status" aria-live="polite"></div>
      <button
        type="submit"
        id="submit"
        class="btn btn-effect wow fadeInUp"
        data-wow-delay="0.8s"
      >
        <Icon name="check" /> Send Message
      </button>
    </div>
  </div>
</form>

<script>
  (() => {
    const form = document.querySelector<HTMLFormElement>("#contactForm");
    if (!form) return;

    const encode = (data: Record<string, string>) =>
      Object.keys(data)
        .map((key) => encodeURIComponent(key) + "=" + encodeURIComponent(data[key]))
        .join("&");

    const setStatus = (status: string) => {
      const el = document.querySelector<HTMLDivElement>("#formStatus");
      const btn = document.querySelector<HTMLButtonElement>("#submit");
      if (!el) return;

      if (status === "SUCCESS") {
        el.textContent = "Thanks!";
        if (btn) btn.style.display = "none";
      } else if (status === "ERROR") {
        el.textContent = "Ooops! There was an error.";
      }
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: encode({ "form-name": "contact", ...data }),
      })
        .then(() => {
          form.reset();
          setStatus("SUCCESS");
        })
        .catch(() => setStatus("ERROR"));
    });
  })();
</script>
