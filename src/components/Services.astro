---
import Icon from "./Icon.astro";
---

<section id="service" class="services-area section-padding">
  <div
    class="container"
    data-aos="fade"
    data-aos-delay="300"
    data-aos-duration="1000"
  >
    <div class="section-title">
      <h2>What I Offer</h2>
    </div>
    <div class="row">
      <div class="col-md-4">
        <div class="single-service text-center wow fadeInUp" data-wow-delay="0.4s">
          <Icon name="codepen" />
          <h2>Ideas</h2>
          <p>
            A unique approach to problems viewing them from both the business and
            tech angles.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="single-service text-center wow fadeInUp" data-wow-delay="0.6s">
          <Icon name="pencil" />
          <h2>Design</h2>
          <p>
            Experience building user-friendly interfaces for both mobile and
            desktop.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="single-service text-center wow fadeInUp" data-wow-delay="0.8s">
          <Icon name="laptop" />
          <h2>Programming</h2>
          <p>
            Ability to implement current frameworks to provide solutions to
            problems.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
